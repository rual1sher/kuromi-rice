// Kuromi rice fastfetch — run with: fastfetch -c ~/.config/fastfetch/kuromi.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/kuromi.ans",
    "width": 26,
    "height": 11,
    "padding": { "top": 1, "left": 2, "right": 1 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;195;166;247", "title": "38;2;245;154;184" },
    "disableLinewrap": true,
    "key": { "paddingLeft": 2 }
  },
  "modules": [
    { "type": "title", "format": "  {user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "  \u001b[38;2;107;98;136m─────────────────────────" },
    { "type": "os", "key": "󰣇 os" },
    { "type": "kernel", "key": " kernel" },
    { "type": "wm", "key": " wm" },
    { "type": "terminal", "key": " term" },
    { "type": "cpu", "key": " cpu", "format": "{name}" },
    { "type": "memory", "key": " ram" },
    { "type": "uptime", "key": "󰅐 uptime" },
    { "type": "media", "key": "󰎆 music", "format": "{artist} - {title}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
